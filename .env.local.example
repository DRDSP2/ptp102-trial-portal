# Supabase project credentials (publishable key - safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Compute service proxy path. Keep relative so dev and production use the same route.
VITE_COMPUTE_API_URL=/compute

# Service role key - NEVER expose to the client. Used only by serverless functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin user seed (scripts/seedAdmin.ts)
ADMIN_EMAIL=your-admin@example.com
ADMIN_NAME=Admin
# Optional — defaults to https://byrock.eth.limo/ (root, to avoid IPFS sub-path 404s)
# ADMIN_REDIRECT_URL=https://byrock.eth.limo/
# E2E backend state verifier - staging/test only, never production.
E2E_BACKEND_STATE_ENABLED=false
E2E_BACKEND_STATE_TOKEN=replace-with-long-random-test-token

# --- Data-layer migration feature flags (default: false) -------------------
# Flip a flag to route a single domain at the live Supabase tables instead of
# the in-memory mock. Leave OFF in production until the migration for that
# domain has been verified against RLS policies.
# VITE_USE_SUPABASE_PATIENTS=false
# VITE_USE_SUPABASE_TREATMENTS=false
# VITE_USE_SUPABASE_CLINICAL_ASSESSMENTS=false
# VITE_USE_SUPABASE_CLINICAL_NOTES=false
# VITE_USE_SUPABASE_LAB_RESULTS=false
# VITE_USE_SUPABASE_VETERINARIANS=false

